SERVER_PORT=3000
SERVER_HOST=localhost
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=./messages.db
CRON_SCHEDULE=0 * * * *  # Run every hour
RETENTION_PERIOD_HOURS=48  # Retention period for messages

# Keycloak token verification.
# Either set KEYCLOAK_JWKS_URI directly, or set KEYCLOAK_URL + KEYCLOAK_REALM to derive it.
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=my-realm
# KEYCLOAK_JWKS_URI=https://auth.example.com/realms/my-realm/protocol/openid-connect/certs

# Optional: require this realm role to access the API (leave unset to accept any valid token).
REALM_ACCESS=READ_SMS
